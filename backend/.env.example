# Môi trường chạy (development / production)
NODE_ENV=development
PORT=5000

# Chuỗi kết nối đến MongoDB Atlas
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster-url>/e_logistic?appName=Cluster0"

# JWT Secret Key (Khóa bí mật bắt buộc phải có để khởi động Server)
JWT_SECRET=super_secret_logistics_key_2026
JWT_EXPIRES_IN=30d
