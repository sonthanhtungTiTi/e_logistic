# ==============================================================================
# E-LOGISTICS ECOSYSTEM DEVELOPMENT ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================

# ── Backend Express Server Configuration ─────────────────────────────────────
NODE_ENV=development
PORT=5000

# ── Infrastructure Connections (Mapped via Localhost Ports) ────────────────
# Backend running on Host OS connects to Docker containers via localhost ports
MONGODB_URI=mongodb://localhost:27017/e_logistic
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# ── Security & Authentication Tokens ──────────────────────────────────────────
JWT_SECRET=elogistics_super_secret_jwt_key_2026_dev_mode_only
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=elogistics_super_secret_refresh_jwt_key_2026
JWT_REFRESH_EXPIRES_IN=7d

# ── Internal AI FastAPI Microservice Connection ──────────────────────────────
AI_SERVICE_URL=http://localhost:8000

# ── Optional Mailer Configuration (Development Sandbox) ─────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=dev.sandbox@elogistics.vn
SMTP_PASS=app_password_sandbox_only
